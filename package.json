{
  "name": "nova",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "postbuild": "react-snap"
  },
 "reactSnap": {
  "source": "dist",
  "inlineCss": true,
  "include": [
    "/",
    "/about",
    "/products/tablets/femanova",
    "/products/tablets/tamonova",
    "/products/injectables/testova-p",
    "/404.html"
  ],
  "puppeteerArgs": [
    "--no-sandbox",
    "--disable-setuid-sandbox"
  ],
  "waitFor": 2000
},

  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@tailwindcss/vite": "^4.1.14",
    "aos": "^2.3.4",
    "framer-motion": "^12.23.24",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.548.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-head": "^3.4.2",
    "react-helmet": "^6.1.0",
    "react-icons": "^5.5.0",
    "react-intersection-observer": "^10.0.0",
    "react-medium-image-zoom": "^5.4.0",
    "react-router-dom": "^6.30.2",
    "swiper": "^12.0.2",
    "tailwindcss": "^4.1.14",
    "three": "^0.180.0",
    "vanta": "^0.5.24",
    "vite-plugin-image-optimizer": "^2.0.2",
    "vite-plugin-ssr": "^0.4.142"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "react-snap": "^1.23.0",
    "vite": "^7.1.7",
    "vite-imagetools": "^9.0.0",
    "vite-plugin-prerender": "^1.0.8"
  }
}
